# ---- Runtime environment -------------------------------------------------------------
# dev | test | prod.  prod REFUSES API keys: use a managed identity instead.
ENVIRONMENT=dev
# DEBUG | INFO | WARNING | ERROR. Logs go to stderr as JSON and never contain document text.
LOG_LEVEL=INFO

# ---- Azure Document Intelligence -----------------------------------------------------
# Must start with https://
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-resource-name>.cognitiveservices.azure.com/
# Leave unset to use Microsoft Entra ID (DefaultAzureCredential / managed identity).
# AZURE_DOCUMENT_INTELLIGENCE_KEY=<dev-only-key>
# prebuilt-layout (default; Markdown output) or prebuilt-read (Markdown is not requested).
AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-layout
OCR_TIMEOUT_SECONDS=120
OCR_MAX_RETRIES=3
# Words below this Document Intelligence confidence are flagged for review (0 < x <= 1).
OCR_CONFIDENCE_THRESHOLD=0.85

# ---- Preprocessing -------------------------------------------------------------------
# minimal (default): validate and send the original image.
# enhanced: bounded deskew + illumination flattening + light denoise. Enable only if your
# de-identified evaluation set shows it improves results.
PREPROCESS_MODE=minimal
MAX_INPUT_BYTES=52428800

# ---- Azure OpenAI (structured extraction) --------------------------------------------
ENABLE_LLM=false
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-chat-latest
# Leave unset to use Entra ID.
# AZURE_OPENAI_API_KEY=<dev-only-key>
# Leave unset to use the v1 GA API (<endpoint>/openai/v1/). Set it to keep using the legacy
# AzureOpenAI client with a dated api-version, e.g. 2024-10-01-preview.
# AZURE_OPENAI_API_VERSION=
# Override the Entra ID token scope only if your resource requires it.
# AZURE_OPENAI_TOKEN_SCOPE=
# Unset = temperature is not sent. Set (e.g. 0) only after confirming the deployed model accepts it.
# LLM_TEMPERATURE=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_INPUT_CHARS=60000
